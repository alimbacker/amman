{
  "name": "functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "sync-shared": "node ../scripts/sync-shared.mjs",
    "build": "npm run sync-shared && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "seed": "npm run build && node lib/scripts/seed.js",
    "set-admin": "npm run build && node lib/scripts/setAdmin.js",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
